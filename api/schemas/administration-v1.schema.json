{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/administration/v1",
  "title": "ThinkPixelMP administrative actions v1",
  "$defs": {
    "publisherState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code"],
      "properties": {
        "state": {"type": "string", "enum": ["verified", "suspended", "revoked"]},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "explanation": {"type": "string", "maxLength": 4096}
      }
    },
    "delegationCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_prefix", "publisher_id"],
      "properties": {
        "child_prefix": {"$ref": "common-v1.schema.json#/$defs/namespace"},
        "publisher_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant_id", "namespace_id", "child_prefix", "publisher_id", "state", "created_at"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "tenant_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "namespace_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "child_prefix": {"$ref": "common-v1.schema.json#/$defs/namespace"},
        "publisher_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "state": {"type": "string", "enum": ["active", "revoked"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "snapshotCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"parent_snapshot_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}}
    },
    "digestReconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digests"],
      "properties": {"digests": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}}}
    },
    "digestReconcileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "event_cursor", "items"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "event_cursor": {"type": "string", "minLength": 1, "maxLength": 1024},
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "state"],
            "properties": {
              "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
              "state": {"type": "string", "enum": ["active", "deprecated", "quarantined", "revoked", "unknown"]}
            }
          }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 4096}}
    }
  }
}

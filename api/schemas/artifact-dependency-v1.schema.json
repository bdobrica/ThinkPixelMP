{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/artifact-dependency/v1",
  "title": "ThinkPixelMP ArtifactDependency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "artifact", "required", "selector"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
    "artifact": {"$ref": "common-v1.schema.json#/$defs/artifactIdentity"},
    "required": {"type": "boolean"},
    "catalog": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest"],
          "properties": {"digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {"version": {"$ref": "common-v1.schema.json#/$defs/semver"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range"],
          "properties": {
            "range": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        }
      ]
    }
  }
}

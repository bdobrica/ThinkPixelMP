{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/artifact-lock/v1",
  "title": "ThinkPixelMP ArtifactLock v1",
  "description": "Immutable dependency graph. lock_digest is SHA-256 over RFC 8785 canonical JSON with lock_digest omitted. Nodes and edges are sorted by their documented canonical keys before digesting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_algorithm", "root_digest", "nodes", "edges", "context", "created_at", "lock_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "resolution_algorithm": {"const": "thinkpixelmp-resolution-v1"},
    "root_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/edge"}},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "catalog_snapshot_digest", "policy_digest", "evidence_snapshot_digest"],
      "properties": {
        "catalog_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "catalog_snapshot_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "policy_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "evidence_snapshot_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "lock_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "artifact", "version", "kind", "descriptor_digest", "effective_requirement_digest"],
      "properties": {
        "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "artifact": {"$ref": "common-v1.schema.json#/$defs/artifactIdentity"},
        "version": {"$ref": "common-v1.schema.json#/$defs/semver"},
        "kind": {"type": "string", "enum": ["skill", "agent-runtime", "mcp-server", "remote-agent", "bundle"]},
        "descriptor_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "effective_requirement_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["parent_digest", "dependency_index", "dependency_name", "child_digest"],
      "properties": {
        "parent_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "dependency_index": {"type": "integer", "minimum": 0, "maximum": 255},
        "dependency_name": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
        "child_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}
      }
    }
  }
}

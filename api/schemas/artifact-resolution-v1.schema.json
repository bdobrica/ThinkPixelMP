{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/artifact-resolution/v1",
  "title": "ThinkPixelMP ArtifactResolution v1",
  "$defs": {
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "artifact_id", "selector"],
      "properties": {
        "catalog_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "artifact_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "selector": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["artifact_version_id"], "properties": {"artifact_version_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"}}},
            {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"$ref": "common-v1.schema.json#/$defs/semver"}}},
            {"type": "object", "additionalProperties": false, "required": ["range"], "properties": {"range": {"type": "string", "minLength": 1, "maxLength": 255}}}
          ]
        },
        "selected_optional_dependencies": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/dnsToken"}}
      }
    },
    "currentImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected", "observed_at", "event_cursor", "nodes"],
      "properties": {
        "affected": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "event_cursor": {"type": "string", "minLength": 1, "maxLength": 1024},
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "state"],
            "properties": {
              "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
              "state": {"type": "string", "enum": ["quarantined", "revoked"]}
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "version", "digest", "kind", "lifecycle"],
      "properties": {
        "artifact": {"$ref": "common-v1.schema.json#/$defs/artifactIdentity"},
        "version": {"$ref": "common-v1.schema.json#/$defs/semver"},
        "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "kind": {"type": "string", "enum": ["skill", "agent-runtime", "mcp-server", "remote-agent", "bundle"]},
        "lifecycle": {"type": "string", "enum": ["active", "deprecated", "quarantined", "revoked"]},
        "requirement_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_algorithm", "input_digest", "id", "tenant_id", "catalog_id", "root_digest", "lock_digest", "policy_digest", "evidence_snapshot_digest", "created_at", "lifecycle_observed_at", "event_cursor", "resolution_digest", "signing_identity"],
  "properties": {
    "schema_version": {"const": 1},
    "resolution_algorithm": {"const": "thinkpixelmp-resolution-v1"},
    "input_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
    "tenant_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
    "catalog_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
    "root_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "lock_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "policy_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "evidence_snapshot_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/node"}},
    "created_at": {"type": "string", "format": "date-time"},
    "lifecycle_observed_at": {"type": "string", "format": "date-time"},
    "event_cursor": {"type": "string", "minLength": 1, "maxLength": 1024},
    "resolution_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
    "signing_identity": {"type": "string", "minLength": 1, "maxLength": 512},
    "signature_reference": {"type": "string", "minLength": 1, "maxLength": 2048}
  }
}

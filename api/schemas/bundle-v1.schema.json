{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/bundle/v1",
  "title": "ThinkPixelMP Bundle descriptor v1",
  "description": "Author-facing composite descriptor. Effective requirements are resolved as the union of this descriptor and selected transitive components; incompatibility fails resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "artifact", "requirements", "dependencies", "spec"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "bundle"},
    "artifact": {"$ref": "artifact-descriptor-v1.schema.json#/$defs/coordinates"},
    "requirements": {"$ref": "artifact-descriptor-v1.schema.json#/$defs/requirements"},
    "dependencies": {"$ref": "artifact-descriptor-v1.schema.json#/$defs/dependencies"},
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_kinds", "requirement_aggregation"],
      "properties": {
        "allowed_kinds": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "enum": ["skill", "agent-runtime", "mcp-server", "remote-agent", "bundle"]}
        },
        "requirement_aggregation": {"const": "transitive-union-fail-on-conflict-v1"}
      }
    }
  }
}

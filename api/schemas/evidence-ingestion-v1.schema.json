{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thinkpixel.io/thinkpixelmp/evidence-ingestion/v1",
  "title": "ThinkPixelMP evidence ingestion v1",
  "$defs": {
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_version_id", "subject_digest", "category", "producer_event_id", "report", "created_at", "observed_at"],
      "properties": {
        "artifact_version_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "subject_digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
        "category": {"$ref": "evidence-record-v1.schema.json#/properties/category"},
        "producer_event_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "report": {"$ref": "#/$defs/report"},
        "created_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "report": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "digest", "media_type", "size_bytes"],
          "properties": {
            "kind": {"const": "oci"},
            "reference": {"type": "string", "minLength": 1, "maxLength": 2048},
            "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
            "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
            "size_bytes": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "store", "object_key", "digest", "media_type", "size_bytes"],
          "properties": {
            "kind": {"const": "object-store"},
            "store": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
            "object_key": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000\\r\\n]+$"},
            "digest": {"$ref": "common-v1.schema.json#/$defs/sha256Digest"},
            "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
            "size_bytes": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "producerCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "allowed_categories", "authentication"],
      "properties": {
        "name": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
        "allowed_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "evidence-record-v1.schema.json#/properties/category"}
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "identity"],
          "properties": {
            "mode": {"type": "string", "enum": ["oidc", "mtls", "signed-attestation"]},
            "identity": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant_id", "name", "allowed_categories", "authentication", "state", "created_at"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "tenant_id": {"$ref": "common-v1.schema.json#/$defs/uuidV7"},
        "name": {"$ref": "common-v1.schema.json#/$defs/dnsToken"},
        "allowed_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "evidence-record-v1.schema.json#/properties/category"}},
        "authentication": {"$ref": "#/$defs/producerCreate/properties/authentication"},
        "state": {"type": "string", "enum": ["enabled", "disabled"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
